# ===== PostgreSQL (ChirpStack backend) =====
# Internal-only password (postgres is not exposed outside the docker network).
# Defaults are fine; regenerate only if you want extra hardening.
POSTGRES_USER=chirpstack
POSTGRES_PASSWORD=guardian-pg-default-pass-change-if-paranoid
POSTGRES_DB=chirpstack

# ===== ChirpStack =====
CHIRPSTACK_REGION=us915_1
# Signs JWT tokens for the UI/API. Internal use only. Default is fine.
# Regenerate with: openssl rand -hex 32
CHIRPSTACK_API_SECRET=guardian-cs-default-jwt-secret-change-if-paranoid

# ===== ChirpStack auto-registration (chirpstack-init) =====
# Gateway EUI: printed on the LPS8 sticker. Required.
LPS8_GATEWAY_EUI=
LPS8_GATEWAY_NAME=LPS8-master
CHIRPSTACK_TENANT_NAME=ChirpStack
CHIRPSTACK_APPLICATION_NAME=Guardian-app
DEVICE_PROFILE_NAME=US915-Class-A-OTAA

# ===== Node-RED =====
# Encrypts flows_cred.json. The Guardian project doesn't store real creds
# inside Node-RED nodes (they all live in env.json rendered from this file),
# so this secret is essentially unused. Default is fine.
NODERED_CREDENTIAL_SECRET=guardian-nr-default-cred-secret
TZ=America/New_York

# ===== Node-RED editor login (protects the flow editor / admin API) =====
# Generate the hash with:
#   docker exec guardian-nodered-1 node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
NODE_RED_ADMIN_USER=
NODE_RED_ADMIN_PASSWORD_HASH=

# ===== Dashboard login (protects /dashboard, separate from the editor) =====
DASHBOARD_USER=
DASHBOARD_PASSWORD_HASH=

# ===== Sesiones del dashboard (login multi-usuario / RBAC) =====
# Regenerar con: openssl rand -hex 32
SESSION_SECRET=
POSTGRES_HOST=postgres
# Bypass de login del editor de Node-RED en acceso local/LAN. openssl rand -hex 32
LOCAL_EDITOR_BYPASS_SECRET=

# ===== Cloudflare Tunnel (public URL for the dashboard) =====
# Create at one.dash.cloudflare.com -> Zero Trust -> Networks -> Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# ===== GitLab (BUILD-TIME ONLY) =====
# Used by `docker compose build` to clone gitlab.com/costa4844917/enviromental
# into the Node-RED image. The runtime container does NOT need these.
# After a successful build the credentials are no longer used.
# To refresh the project (rare): docker compose build --no-cache nodered
GITLAB_USER=
GITLAB_TOKEN=

# ===== Heromatic private npm registry (BUILD-TIME ONLY) =====
# Currently the @heromatic/* packages are public on npmjs.org so leave
# user/pass empty. Set them only if Heromatic moves to a private registry.
HEROMATIC_NPM_USER=
HEROMATIC_NPM_PASS=
HEROMATIC_NPM_REGISTRY=https://registry.npmjs.org/

# ===== Azure IoT Hub (rendered into env.json) =====
IOT_DEVICE_ID=
IOT_HUB_HOSTNAME=
IOT_SAS_KEY=
AREA_ID=

# ===== Azure Maps + Dragino rain sensor (rendered into rainAzureApi.json) =====
DRAGINO_RAIN_EUI=
AZURE_MAP_KEY=
SITE_LAT=0.0
SITE_LON=0.0

# ===== Modbus gateway (TCP → RS485) =====
# Note: avoid 192.168.1.254 — many home routers use that for their admin UI.
MODBUS_GATEWAY_IP=192.168.1.100
MODBUS_GATEWAY_PORT=502

# ===== Home Assistant (bridge for Tuya/Zigbee sensors) =====
# Long-lived access token from HA: user profile -> Security -> Long-lived
# access tokens. Only needed if you register Home-Assistant-backed sensors
# from the Configuración page.
HA_TOKEN=

# ===== Identidad de esta area (multi-sitio) =====
# ESTO es lo unico que cambia entre despliegues de un mismo template: cada
# PC/sitio fisico es UN area, identificada por su ID+KEY. El resto de este
# archivo (contraseñas, secretos de sesion, etc.) se genera UNA vez por
# instalacion y no tiene que ver con "cual area es esta".
#
# RIEGO_AREA_NAME es opcional si HUB_URL esta configurado: el Edge le
# pregunta el nombre al Hub en cada heartbeat exitoso y lo usa
# automaticamente (ver auth_fn_me) -- no hace falta escribirlo dos veces.
# Sin HUB_URL (o mientras el primer heartbeat no llego), se usa este valor
# como resto.
#
# Sin RIEGO_AREA_ID/RIEGO_AREA_KEY validos (o si HUB_URL esta configurado y
# el Hub los rechaza / revoca), el dashboard REMOTO (via Cloudflare) queda
# bloqueado -- el acceso local nunca se ve afectado.
RIEGO_AREA_ID=
RIEGO_AREA_NAME=
RIEGO_AREA_KEY=

# ===== Hub central de areas (opcional) =====
# Dejar todo esto vacio si esta area no tiene Hub todavia (se usa solo el
# chequeo de formato de RIEGO_AREA_KEY). Si hay un Hub, HUB_URL es su
# direccion (ej. http://hub-nodered:1880 en la misma red Docker, o una URL
# publica si el Hub esta en otra maquina).
HUB_URL=
# NOTA: el intervalo real del heartbeat esta fijo en el flujo (nodo
# "Heartbeat al Hub", cada 30s por defecto) -- esta variable hoy NO lo
# controla (quedo sin conectar). Para cambiarlo hay que editar ese inject
# node directamente. La dejamos documentada por si en el futuro se conecta.
HUB_HEARTBEAT_INTERVAL_MINUTES=10
HUB_GRACE_PERIOD_HOURS=168
